{
  "manifest_version": 3,
  "name": "mpeasy",
  "version": "1.7.1",
  "description": "Descarga canciones o videos de YouTube en MP3 o MP4.",
  "key": "",
  "permissions": ["nativeMessaging", "tabs", "storage", "alarms"],
  "background": { "service_worker": "background.js", "scripts": ["background.js"] },
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "mpeasy",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png" }
  },
  "commands": {
    "download-mp4": {
      "suggested_key": { "default": "Ctrl+Shift+4" },
      "description": "Descargar el video abierto en MP4"
    },
    "download-mp3": {
      "suggested_key": { "default": "Ctrl+Shift+3" },
      "description": "Descargar el video abierto en MP3"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "ytmp4@local",
      "strict_min_version": "128.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  }
}
