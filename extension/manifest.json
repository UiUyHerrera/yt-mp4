{
  "manifest_version": 3,
  "name": "YT MP4",
  "version": "1.5.2",
  "description": "Descarga videos de YouTube en MP4 o MP3.",
  "key": "",
  "permissions": ["nativeMessaging", "tabs", "storage", "alarms"],
  "background": { "service_worker": "background.js", "scripts": ["background.js"] },
  "action": { "default_popup": "popup.html", "default_title": "Descargar MP4 / MP3" },
  "commands": {
    "download-mp4": {
      "suggested_key": { "default": "Ctrl+Shift+4" },
      "description": "Descargar el video abierto en MP4"
    },
    "download-mp3": {
      "suggested_key": { "default": "Ctrl+Shift+3" },
      "description": "Descargar el video abierto en MP3"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "ytmp4@local",
      "strict_min_version": "128.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  }
}
